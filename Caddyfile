(main_site_routes) {
    # Vias public synthetic demo; no SPA fallback or tile proxy.
    redir /vias /vias/ 301
    handle_path /vias/* {
        root * /srv/sites/liangz77.cn/vias/current
        file_server
    }
    redir /mu /mu/ permanent

    @legacy_works path_regexp legacy_works ^/apps/works/(.*)$
    redir @legacy_works /mu/{re.legacy_works.1} permanent

    # 应用短网址：/apps/tools/<名>、/apps/fun/<名> 对外统一暴露为根路径 /<名>/
    # 只做 URL 映射，仓库目录结构保持 apps/tools、apps/fun 不变；
    # 新增应用时，在对应清单里追加名字即可（旧的长地址会自动 301 到短地址）。
    @short_app_tools path_regexp short_app_tools ^/(card910|image-stitch|list-chore|markdown-tab|pic-wall)(?<short_app_tools_rest>/.*)?$
    handle @short_app_tools {
        # 目录地址统一带斜杠，否则页面里的相对资源会解析到站点根
        @short_app_tools_dir expression `{re.short_app_tools.short_app_tools_rest} == ""`
        redir @short_app_tools_dir {path}/ 308
        rewrite * /apps/tools/{re.short_app_tools.1}{re.short_app_tools.short_app_tools_rest}
        root * /srv/sites/liangz77.cn/current
        encode zstd gzip
        file_server
    }

    @short_app_fun path_regexp short_app_fun ^/(snack-snake|digital-maze|tetris888|match-3-game|jump100|whoswolf|apollonius|fermat-point|parabolic-equation|pascal-brianchon|poly-deriv)(?<short_app_fun_rest>/.*)?$
    handle @short_app_fun {
        @short_app_fun_dir expression `{re.short_app_fun.short_app_fun_rest} == ""`
        redir @short_app_fun_dir {path}/ 308
        rewrite * /apps/fun/{re.short_app_fun.1}{re.short_app_fun.short_app_fun_rest}
        root * /srv/sites/liangz77.cn/current
        encode zstd gzip
        file_server
    }

    # 旧的应用长地址永久跳转到短地址：/apps/tools/markdown-tab/… → /markdown-tab/…
    @legacy_apps path_regexp legacy_apps ^/apps/(?:tools|fun)/([^/]+)(/.*)?$
    redir @legacy_apps /{re.legacy_apps.1}{re.legacy_apps.2} permanent

    handle_path /mu/* {
        root * /srv/sites/liangz77.cn/current/apps/works
        file_server
    }

    handle /api/demo/* {
        reverse_proxy 127.0.0.1:9005
    }

    handle /api/demos* {
        reverse_proxy 127.0.0.1:9005
    }

    handle /api/wiki/* {
        reverse_proxy 127.0.0.1:9005
    }

    # Fleeting（随笔）挂在子路径 /fleeting/：应用内部按相对路径引用资源与接口，
    # 因此目录式地址必须收敛到带斜杠的形式，否则相对路径会解析到站点根。
    # /private 保持为 go-sites 自己的「我的」页（在 @tab_routes 里），不加跳转；
    # 「我的」页里有一条指向 https://liangz77.cn/fleeting/ 的应用条目（data.js）。
    handle /fleeting {
        redir * /fleeting/ permanent
    }

    handle_path /fleeting/* {
        reverse_proxy 127.0.0.1:3010
    }

    # 有型（HairPlay）：独立静态版本，文件不存在时直接返回 404。
    handle /hairplay {
        redir * /hairplay/ permanent
    }

    # 有型 API：由独立 hairplay-api 服务处理，不与静态发布目录混放。
    handle /hairplay/api/* {
        reverse_proxy 127.0.0.1:8777 {
            header_up X-Real-IP {remote_host}
        }
    }

    handle_path /hairplay/* {
        root * /srv/sites/liangz77.cn/hairplay/current
        file_server
    }

    handle /wiki {
        respond "Page removed" 410
    }

    @tab_routes path /search /recommendations /ai-tools /dev-tools /tools /fun /private /demo
    handle @tab_routes {
        reverse_proxy 127.0.0.1:9005
    }

    handle /demo/* {
        reverse_proxy 127.0.0.1:9005
    }

    handle /wiki/* {
        reverse_proxy 127.0.0.1:9005
    }

    # 中转站：本机（Paseo / 本地 Pi）与云端助手之间的存储转发网关。
    # 路径保持 /relay 前缀，由网关自己按 RELAY_BASE_PATH 处理。
    handle /relay/* {
        reverse_proxy 127.0.0.1:9015
    }

    root * /srv/sites/liangz77.cn/current
    encode zstd gzip
    file_server
}

http://49.232.129.114 {
    import main_site_routes
}

http://liangz77.cn, http://www.liangz77.cn {
    redir https://liangz77.cn{uri} permanent
}

https://liangz77.cn {
    import main_site_routes
}

https://www.liangz77.cn {
    redir https://liangz77.cn{uri} permanent
}

http://resume.liangz77.cn {
    redir https://resume.liangz77.cn{uri} permanent
}

https://resume.liangz77.cn {
    root * /srv/sites/liangz77.cn/current/apps/resume
    encode zstd gzip
    file_server
}

https://mu-zhang.cn {
    encode zstd gzip
    redir /study-flow /study-flow/ permanent
    handle_path /study-flow/* {
        reverse_proxy 127.0.0.1:8093
    }
    redir /mu / permanent
    @old_mu path_regexp old_mu ^/mu/(.*)$
    redir @old_mu /{re.old_mu.1} permanent

    handle /data.js {
        root * /srv/sites/liangz77.cn/current
        file_server
    }
    @old_wisecut path_regexp old_wisecut ^/demo(/WiseCut-test-summary(?:/.*)?)$
    redir @old_wisecut {re.old_wisecut.1}?{query} permanent
    redir /WiseCut-test-summary /WiseCut-test-summary/ permanent
    handle /WiseCut-test-summary/* {
        rewrite * /demo{uri}
        reverse_proxy 127.0.0.1:9005
    }
    handle {
        root * /srv/sites/liangz77.cn/current/apps/works
        file_server
    }
}

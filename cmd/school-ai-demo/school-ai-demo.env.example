# Copy to /srv/apps/school-ai-demo/shared/school-ai-demo.env and chmod 600.

# Listen address. Caddy reverse-proxies /school-ai-demo/* here, so keep it on
# loopback; nothing needs to reach this port from outside.
SCHOOL_AI_DEMO_ADDR=127.0.0.1:9025

# Public path prefix. Caddy's handle block and this must agree, or the page
# loads but its /api calls 404.
SCHOOL_AI_DEMO_BASE_PATH=/school-ai-demo

# SQLite lives here (WAL, so the directory needs to be writable).
SCHOOL_AI_DEMO_DATA_DIR=/srv/apps/school-ai-demo/shared/data

# Model credentials. Without a key the page still works and says so in plain
# words; only the AI fill is unavailable. Nothing here is ever logged.
SCHOOL_AI_DEEPSEEK_API_KEY=

# Optional second key, tried once if the primary answers 401, 402 or 429.
# SCHOOL_AI_DEEPSEEK_API_KEY_BACKUP=

# BASE url, not a full one: /chat/completions is appended. This deployment
# uses an OpenCode Go subscription, which speaks the OpenAI protocol but wants
# an x-opencode-session header on every request (sent automatically when the
# base mentions "opencode").
# SCHOOL_AI_DEEPSEEK_BASE_URL=https://opencode.ai/inference/go/openai/v1
# SCHOOL_AI_DEEPSEEK_MODEL=deepseek-v4.1-flash

# AI fills per Asia/Shanghai day. 0 disables the limit. Export, manual editing
# and the demo list are never counted.
SCHOOL_AI_DAILY_LIMIT=100

# Copy to /srv/apps/go-sites-keys/shared/keys.env and chmod 600.
# The deploy script creates this file on first deployment from DEMO_ADMIN_PASSWORD.

KEYS_ADDR=127.0.0.1:9020
KEYS_DATA_DIR=/srv/apps/go-sites-keys/shared/data
KEYS_DB_PATH=/srv/apps/go-sites-keys/shared/data/keys.db
KEYS_PUBLIC_ORIGIN=https://liangz77.cn
KEYS_COOKIE_SECURE=true

# The master key encrypts every API Key with AES-256-GCM. Keep it outside the
# database directory and back it up separately. It must decode to exactly 32
# bytes with base64 (standard, raw, or URL-safe encoding).
KEYS_MASTER_KEY_FILE=/srv/secrets/liangz77-keys/master.key
KEYS_SESSION_SECRET_FILE=/srv/secrets/liangz77-keys/session.key

# Generate with:
#   printf '%s' 'your password' | ./go-sites-keys -hash-password
# Do not store the plaintext password in this file.
KEYS_ADMIN_PASSWORD_HASH='$2a$12$replace-with-a-bcrypt-hash'

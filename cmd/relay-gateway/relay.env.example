# 监听地址：只绑本机，外面的请求统一由 Caddy 反代进来
RELAY_ADDR=127.0.0.1:9015
RELAY_BASE_PATH=/relay
RELAY_DATA_DIR=/srv/apps/relay-gateway/shared/data

# 两个 token 必须不同：local 给本机用，cloud 只在我这边用
RELAY_LOCAL_TOKEN=change-me-local
RELAY_CLOUD_TOKEN=change-me-cloud

# 本机 -> 云端：转发到「本地 Paseo 消息」这条例行任务的 webhook
RELAY_WEBHOOK_URL=
RELAY_WEBHOOK_SECRET=

# 任务租约（秒）：本地领走任务后多久没回执就重新可领
RELAY_LEASE_SECONDS=600

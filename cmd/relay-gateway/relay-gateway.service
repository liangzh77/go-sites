[Unit]
Description=Relay gateway between local Paseo and Grok Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=caddy
Group=caddy
WorkingDirectory=/srv/apps/relay-gateway/shared
EnvironmentFile=/srv/apps/relay-gateway/shared/relay.env
ExecStart=/srv/apps/relay-gateway/current/relay-gateway
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/apps/relay-gateway/shared

[Install]
WantedBy=multi-user.target
